# Copia este archivo como .env (en la raíz del repo) y escribe ahí tus valores reales.
# El .env está en .gitignore: nunca se sube a GitHub. Este .env.example sí, pero sin valores.

# --- Base de datos PostgreSQL (en producción, Neon con "Connection pooling" apagado) ---
# Spring Boot las reconoce solas: SPRING_DATASOURCE_URL equivale a spring.datasource.url.
# La URL empieza con jdbc: y NO lleva usuario ni contraseña (esos van en sus propias variables).
# Ejemplo de forma:  jdbc:postgresql://HOST/BASE?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Pocas conexiones abiertas a la vez: ahorra memoria en el plan gratis.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3

# --- Llave para firmar los gafetes de inicio de sesión (JWT) ---
# El chatbot usa la MISMA llave para reconocer a los empleados que atienden quejas.
# Mínimo 32 caracteres al azar. Puedes generarla con:  openssl rand -base64 48
PECDMX_JWT_SECRETO=

# --- Páginas web que pueden usar la API desde el navegador (CORS), separadas por comas ---
# Con http:// o https:// y sin / al final. Sin esta variable se permite solo http://localhost:5173 (Vite).
PECDMX_CORS_ORIGENES=

# --- Primer gerente del backend (se crea solo si la base de datos no tiene usuarios) ---
PECDMX_GERENTE_CORREO=
PECDMX_GERENTE_NOMBRE=
# Mínimo 12 caracteres.
PECDMX_GERENTE_CONTRASENA=

# --- Chatbot: base de datos con pgvector (la misma de Neon, en su propio esquema "chatbot") ---
# Formato de Python (distinto al de Java): postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DATABASE_URL=

# --- Chatbot: dirección del backend al que pregunta rastreos y cotizaciones ---
# Por defecto http://localhost:8080. En Render: https://pecdmx.onrender.com
BACKEND_URL=

# --- Chatbot: LLM principal (https://console.groq.com → API Keys) ---
GROQ_API_KEY=
# Opcional. Por defecto: openai/gpt-oss-120b
GROQ_MODELO=

# --- Chatbot: LLM de respaldo (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.5-flash
GEMINI_MODELO=
