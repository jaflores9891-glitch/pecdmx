# Copia este archivo como .env (en la raíz del repo) y escribe ahí tus valores reales.
# El .env está en .gitignore: nunca se sube a GitHub. Este .env.example sí, pero sin valores.

# --- Base de datos PostgreSQL (en producción, Neon con "Connection pooling" apagado) ---
# Spring Boot las reconoce solas: SPRING_DATASOURCE_URL equivale a spring.datasource.url.
# La URL empieza con jdbc: y NO lleva usuario ni contraseña (esos van en sus propias variables).
# Ejemplo de forma:  jdbc:postgresql://HOST/BASE?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Pocas conexiones abiertas a la vez: ahorra memoria en el plan gratis.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3

# --- Llave para firmar los gafetes de inicio de sesión (JWT) ---
# Mínimo 32 caracteres al azar. Puedes generarla con:  openssl rand -base64 48
PECDMX_JWT_SECRETO=

# --- Primer gerente del backend (se crea solo si la base de datos no tiene usuarios) ---
PECDMX_GERENTE_CORREO=
PECDMX_GERENTE_NOMBRE=
# Mínimo 12 caracteres.
PECDMX_GERENTE_CONTRASENA=
