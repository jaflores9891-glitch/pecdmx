# Copia este archivo como .env (en la raíz del repo) y escribe ahí tus valores reales.
# El .env está en .gitignore: nunca se sube a GitHub. Este .env.example sí, pero sin valores.

# --- Llave para firmar los gafetes de inicio de sesión (JWT) ---
# Mínimo 32 caracteres al azar. Puedes generarla con:  openssl rand -base64 48
PECDMX_JWT_SECRETO=

# --- Primer gerente del backend (se crea solo si la base de datos no tiene usuarios) ---
PECDMX_GERENTE_CORREO=
PECDMX_GERENTE_NOMBRE=
# Mínimo 12 caracteres.
PECDMX_GERENTE_CONTRASENA=
