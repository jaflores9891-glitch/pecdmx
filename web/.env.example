# Copia este archivo como .env.local para elegir a qué backend se conecta la página.
# Solo las variables que empiezan con VITE_ llegan al navegador: aquí NUNCA va nada secreto.

# Dirección pública del backend. Sin esta variable, la página usa el backend local (http://localhost:8080).
VITE_API_URL=https://pecdmx.onrender.com
